# Installed to /etc/systemd/system/skimr.service by deploy/install.sh.
# Settings live in /etc/skimr/skimr.env (SKIMR__Section__Key=value); data in /var/lib/skimr.
[Unit]
Description=Skimr feed reader
Documentation=https://github.com/stevehellier/skimr
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=skimr
Group=skimr
WorkingDirectory=/opt/skimr
EnvironmentFile=/etc/skimr/skimr.env
Environment=SKIMR__Storage__DataDirectory=/var/lib/skimr
# The single-file build unpacks its native libraries here (systemd creates /var/cache/skimr).
CacheDirectory=skimr
Environment=DOTNET_BUNDLE_EXTRACT_BASE_DIR=/var/cache/skimr
ExecStart=/opt/skimr/Skimr
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
UMask=0027

# Hardening. MemoryDenyWriteExecute is left off: the .NET JIT needs writable+executable memory.
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/skimr
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
RemoveIPC=true
CapabilityBoundingSet=
AmbientCapabilities=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
