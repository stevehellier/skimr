# Copy to deploy/.env (ignored by git) and change the password.
# Generate one with: openssl rand -base64 24
POSTGRES_PASSWORD=change-me

# Image version: a release such as 0.1.1, a minor line such as 0.1, or latest (default).
# SKIMR_VERSION=latest

# Host port for the web UI (default 8080).
# SKIMR_PORT=8080
