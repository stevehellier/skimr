<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet publish src/Skimr.Web -p:PublishProfile=linux-arm64  ->  artifacts/publish/linux-arm64 -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Native SQLite goes inside the single file too. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No trimming: EF Core, Identity and Blazor rely on reflection. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <!-- Also leave out the referenced projects' .pdb files. -->
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)../../../../artifacts/publish/linux-arm64/</PublishDir>
  </PropertyGroup>
</Project>
