@page "/status/{Code:int}"
@attribute [AllowAnonymous]

<PageTitle>@Title · Skimr</PageTitle>

<h1>@Title</h1>
<p>@Message</p>
<p><a href="">Go to the home page</a></p>

@code {
    [Parameter]
    public int Code { get; set; }

    private string Title => Code switch
    {
        404 => "Not found",
        429 => "Too many attempts",
        403 => "Access denied",
        _ => "Something went wrong",
    };

    private string Message => Code switch
    {
        404 => "There's nothing at this address.",
        429 => "Wait a minute, then try again.",
        403 => "Your account can't open that page.",
        _ => $"The server answered with status {Code}.",
    };
}
