@page "/"
@page "/today"
@page "/saved"
@page "/folder/{FolderId:long}"
@page "/source/{SourceId:long}"
@page "/board/{BoardId:long}"
@page "/ai/{AiFeedId:long}"
@page "/search"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@implements IAsyncDisposable
@using System.Security.Claims
@using Skimr.Domain
@using Skimr.Infrastructure.Reading
@inject ReadingService Reading
@inject LibraryService Library
@inject FullTextService FullText
@inject Skimr.Infrastructure.Content.ImageProxy Proxy
@inject IJSRuntime JS
@inject NavigationManager Navigation
@inject TimeProvider Time
@inject Skimr.Infrastructure.Ai.AiService Ai

<PageTitle>@Title · Skimr</PageTitle>
<SessionWatch />

<div class="reader @(_navOpen ? "nav-open" : null) @(_article is not null ? "pane-open" : null)">
    <aside class="reader-nav" id="reader-nav">
        <button type="button" class="secondary nav-close" @onclick="() => _navOpen = false">Close</button>
        <NavPanel Nav="_nav" Current="_view" OnAddSource="OpenAddSourceAsync" ShowAiFeeds="Ai.Available" />
    </aside>

    <section class="reader-main" aria-labelledby="view-title">
        <div class="toolbar">
            <button type="button" class="icon nav-toggle" aria-expanded="@(_navOpen ? "true" : "false")" aria-controls="reader-nav" @onclick="() => _navOpen = !_navOpen">
                <span aria-hidden="true">☰</span><span class="visually-hidden">Show feeds</span>
            </button>
            <h1 id="view-title" tabindex="-1">@Title</h1>
            <form class="search-form" role="search" @onsubmit="SubmitSearch">
                <label class="visually-hidden" for="search-box">Search articles</label>
                <input id="search-box" type="search" maxlength="200" placeholder="Search (/)" @bind="_searchInput" />
            </form>
            <div class="toolbar-actions">
                <div role="group" aria-label="Layout" class="segmented">
                    @foreach (var layout in Enum.GetValues<ArticleLayout>())
                    {
                        <button type="button" aria-pressed="@(_preference.Layout == layout ? "true" : "false")" @onclick="() => SetLayoutAsync(layout)">@LayoutLabel(layout)</button>
                    }
                </div>
                <label class="visually-hidden" for="sort">Sort</label>
                <select id="sort" value="@_preference.Sort" @onchange="SetSortAsync">
                    <option value="@ArticleSort.Newest">Newest first</option>
                    <option value="@ArticleSort.Oldest">Oldest first</option>
                </select>
                @if (_view.Kind is not (ViewKind.Saved or ViewKind.Board or ViewKind.Search))
                {
                    <label class="check"><input type="checkbox" checked="@_preference.UnreadOnly" @onchange="SetUnreadOnlyAsync" /> Unread only</label>
                    <button type="button" class="secondary" @onclick="OpenMarkAllAsync" title="Mark all as read (Shift+A)">Mark all read</button>
                }
                <button type="button" class="icon" @onclick="ShowHelpAsync" title="Keyboard shortcuts (?)"><span aria-hidden="true">?</span><span class="visually-hidden">Keyboard shortcuts</span></button>
            </div>
        </div>

        @if (_view.Kind == ViewKind.Search)
        {
            <div class="search-filters" role="group" aria-label="Search filters">
                <label>Source
                    <select value="@SearchSource" @onchange="e => SetSearchFilter(source: e.Value as string)">
                        <option value="">Any</option>
                        @foreach (var s in _nav.Folders.SelectMany(f => f.Sources).Concat(_nav.Unfiled).DistinctBy(s => s.SubscriptionId).OrderBy(s => s.Title))
                        {
                            <option value="@s.SubscriptionId">@s.Title</option>
                        }
                    </select>
                </label>
                <label>Folder
                    <select value="@SearchFolder" @onchange="e => SetSearchFilter(folder: e.Value as string)">
                        <option value="">Any</option>
                        @foreach (var f in _nav.Folders)
                        {
                            <option value="@f.Id">@f.Name</option>
                        }
                    </select>
                </label>
                <label>From <input type="date" value="@SearchFrom" @onchange="e => SetSearchFilter(from: e.Value as string)" /></label>
                <label>To <input type="date" value="@SearchTo" @onchange="e => SetSearchFilter(to: e.Value as string)" /></label>
                <label>Show
                    <select value="@(SearchRead ?? "")" @onchange="e => SetSearchFilter(read: e.Value as string)">
                        <option value="">Read and unread</option>
                        <option value="unread">Unread</option>
                        <option value="read">Read</option>
                    </select>
                </label>
            </div>
        }

        @if (_loading)
        {
            <p class="empty" role="status">Loading…</p>
        }
        else
        {
            <ArticleList Items="_items" Layout="_preference.Layout" SelectedId="_article?.ArticleId" Now="Time.GetUtcNow().UtcDateTime"
                         EmptyText="@EmptyText" OnOpen="OpenAsync" OnToggleSaved="ToggleSavedAsync" OnToggleRead="ToggleReadAsync" />
            @if (_next is not null)
            {
                <div id="list-end"></div>
                <button type="button" class="secondary load-more" @onclick="LoadMoreAsync" disabled="@_loadingMore">Load more</button>
            }
        }
    </section>

    @if (_article is not null)
    {
        <ArticlePane Article="_article" OnClose="CloseAsync" OnToggleSaved="() => ToggleSavedAsync(_article.ArticleId)" OnToggleRead="() => ToggleReadAsync(_article.ArticleId)"
                     OnLoadFullText="LoadFullTextAsync" FullTextLoading="_fullTextLoading" FullTextError="@_fullTextError">
            <BoardPicker UserId="_userId" ArticleId="_article.ArticleId" OnChanged="ReloadNavAndRenderAsync" />
            <SummaryBox UserId="_userId" ArticleId="_article.ArticleId" />
        </ArticlePane>
    }
</div>

<dialog id="mark-all-dialog" aria-labelledby="mark-all-title">
    <h2 id="mark-all-title">Mark as read in “@Title”</h2>
    <div class="dialog-actions">
        <button type="button" @onclick="() => MarkAllReadAsync(null)">Everything</button>
        <button type="button" @onclick="() => MarkAllReadAsync(TimeSpan.FromDays(1))">Older than a day</button>
        <button type="button" @onclick="() => MarkAllReadAsync(TimeSpan.FromDays(7))">Older than a week</button>
        <button type="button" class="secondary" @onclick="@(() => CloseDialogAsync("mark-all-dialog"))">Cancel</button>
    </div>
</dialog>

<dialog id="help-dialog" aria-labelledby="help-title">
    <h2 id="help-title">Keyboard shortcuts</h2>
    <table class="shortcuts">
        <tbody>
            <tr><th scope="row"><kbd>j</kbd> / <kbd>k</kbd></th><td>Next / previous article</td></tr>
            <tr><th scope="row"><kbd>o</kbd> / <kbd>Enter</kbd></th><td>Open the selected article</td></tr>
            <tr><th scope="row"><kbd>v</kbd></th><td>View the original page</td></tr>
            <tr><th scope="row"><kbd>s</kbd></th><td>Save for later / unsave</td></tr>
            <tr><th scope="row"><kbd>m</kbd></th><td>Toggle read</td></tr>
            <tr><th scope="row"><kbd>Shift</kbd>+<kbd>A</kbd></th><td>Mark all as read</td></tr>
            <tr><th scope="row"><kbd>g</kbd> then <kbd>a</kbd> / <kbd>t</kbd> / <kbd>s</kbd></th><td>Go to All / Today / Read Later</td></tr>
            <tr><th scope="row"><kbd>Esc</kbd></th><td>Close the article or dialog</td></tr>
            <tr><th scope="row"><kbd>/</kbd></th><td>Search</td></tr>
            <tr><th scope="row"><kbd>?</kbd></th><td>This help</td></tr>
        </tbody>
    </table>
    
    <div class="dialog-actions"><button type="button" @onclick="@(() => CloseDialogAsync("help-dialog"))">Close</button></div>
</dialog>

<dialog id="add-source-dialog" aria-labelledby="add-source-title">
    <AddSource @ref="_addSource" UserId="_userId" Folders="_folders" OnSubscribed="OnSubscribedAsync" OnCancel="@(() => CloseDialogAsync("add-source-dialog"))" />
</dialog>

@code {
    private Guid _userId;
    private ReaderView _view;
    private string? _loadedKey;
    private ViewPreference _preference = new() { ViewKey = "all" };
    private MarkReadMode _markMode;
    private NavModel _nav = NavModel.Empty;
    private List<ArticleListItem> _items = [];
    private ArticleCursor? _next;
    private ArticleDetail? _article;
    private IReadOnlyList<FolderDetails> _folders = [];
    private AddSource? _addSource;
    private bool _loading = true;
    private bool _loadingMore;
    private bool _fullTextLoading;
    private string? _fullTextError;
    private bool _navOpen;
    private bool _listChanged;
    private string? _focusAfterRender;

    private IJSObjectReference? _module;
    private DotNetObjectReference<Reader>? _self;
    private readonly CancellationTokenSource _disposed = new();

    [CascadingParameter]
    private Task<AuthenticationState> AuthState { get; set; } = null!;

    [Parameter]
    public long? FolderId { get; set; }

    [Parameter]
    public long? SourceId { get; set; }

    [Parameter]
    public long? BoardId { get; set; }

    [Parameter]
    public long? AiFeedId { get; set; }

    [SupplyParameterFromQuery(Name = "q")]
    public string? SearchText { get; set; }

    [SupplyParameterFromQuery(Name = "source")]
    public string? SearchSource { get; set; }

    [SupplyParameterFromQuery(Name = "folder")]
    public string? SearchFolder { get; set; }

    [SupplyParameterFromQuery(Name = "from")]
    public string? SearchFrom { get; set; }

    [SupplyParameterFromQuery(Name = "to")]
    public string? SearchTo { get; set; }

    [SupplyParameterFromQuery(Name = "read")]
    public string? SearchRead { get; set; }

    private string _searchInput = "";

    private string Title => _view.Kind switch
    {
        ViewKind.All => "All",
        ViewKind.Today => "Today",
        ViewKind.Saved => "Read Later",
        ViewKind.Folder => _nav.Folders.FirstOrDefault(f => f.Id == _view.Id)?.Name ?? "Folder",
        ViewKind.Board => _nav.BoardList.FirstOrDefault(b => b.Id == _view.Id)?.Name ?? "Board",
        ViewKind.AiFeed => _nav.AiFeedList.FirstOrDefault(f => f.Id == _view.Id)?.Name ?? "AI feed",
        ViewKind.Search => $"Search: {SearchText}",
        _ => _nav.Folders.SelectMany(f => f.Sources).Concat(_nav.Unfiled).FirstOrDefault(s => s.SubscriptionId == _view.Id)?.Title ?? "Source",
    };

    private string EmptyText => _view.Kind switch
    {
        ViewKind.Saved => "Nothing saved. Press s on an article to read it later.",
        ViewKind.Board => "This board is empty. Open an article and tick this board to add it.",
        ViewKind.AiFeed => _preference.UnreadOnly ? "No unread matches. New articles from this feed's sources are checked every few minutes." : "No matches yet. New articles from this feed's sources are checked every few minutes.",
        ViewKind.Search => string.IsNullOrWhiteSpace(SearchText) ? "Type in the search box and press Enter." : "No articles match.",
        _ when _nav.Folders.Count == 0 && _nav.Unfiled.Count == 0 => "No sources yet. Use “+ Add source” to subscribe to a site or feed.",
        _ => _preference.UnreadOnly ? "All caught up." : "Nothing here yet. New articles appear after the next fetch.",
    };

    /// <summary>Search filters from the query string. Ids are checked against the user by the service.</summary>
    private SearchQuery CurrentSearch() => new(
        SearchText ?? "",
        long.TryParse(SearchSource, out var source) ? source : null,
        long.TryParse(SearchFolder, out var folder) ? folder : null,
        DateTime.TryParseExact(SearchFrom, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.AdjustToUniversal | System.Globalization.DateTimeStyles.AssumeUniversal, out var from) ? from : null,
        DateTime.TryParseExact(SearchTo, "yyyy-MM-dd", null, System.Globalization.DateTimeStyles.AdjustToUniversal | System.Globalization.DateTimeStyles.AssumeUniversal, out var to) ? to.AddDays(1) : null,
        SearchRead switch { "unread" => ReadFilter.Unread, "read" => ReadFilter.Read, _ => ReadFilter.Any });

    private void SubmitSearch()
    {
        var text = _searchInput.Trim();
        if (text.Length > 0)
        {
            Navigation.NavigateTo($"search?q={Uri.EscapeDataString(text)}");
        }
    }

    private void SetSearchFilter(string? source = null, string? folder = null, string? from = null, string? to = null, string? read = null)
    {
        var parameters = new Dictionary<string, object?>
        {
            ["q"] = SearchText,
            ["source"] = source ?? SearchSource,
            ["folder"] = folder ?? SearchFolder,
            ["from"] = from ?? SearchFrom,
            ["to"] = to ?? SearchTo,
            ["read"] = read ?? SearchRead,
        };
        foreach (var key in parameters.Where(p => p.Value is "").Select(p => p.Key).ToList())
        {
            parameters[key] = null;
        }

        Navigation.NavigateTo(Navigation.GetUriWithQueryParameters(parameters));
    }

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthState).User;
        _userId = Guid.Parse(user.FindFirstValue(ClaimTypes.NameIdentifier)!);
        _markMode = await Reading.GetMarkReadModeAsync(_userId, _disposed.Token);
        _ = RefreshNavPeriodicallyAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?')[0].TrimEnd('/');
        _view = FolderId is { } folder ? ReaderView.Folder(folder)
            : SourceId is { } source ? ReaderView.Source(source)
            : BoardId is { } board ? ReaderView.Board(board)
            : AiFeedId is { } aiFeed ? ReaderView.AiFeed(aiFeed)
            : path == "today" ? ReaderView.Today
            : path == "saved" ? ReaderView.Saved
            : path == "search" ? ReaderView.Search
            : ReaderView.All;

        // A search with different text or filters is a different list, though the view is the same.
        var loadKey = _view.Kind == ViewKind.Search ? "search|" + Navigation.Uri : _view.Key;
        if (_loadedKey != loadKey)
        {
            _loadedKey = loadKey;
            _searchInput = _view.Kind == ViewKind.Search ? SearchText ?? "" : "";
            _article = null;
            _navOpen = false;
            _loading = true;
            _preference = await Reading.GetViewPreferenceAsync(_userId, _view, _disposed.Token);
            await Task.WhenAll(ReloadListAsync(), ReloadNavAsync());
            _loading = false;
            _focusAfterRender = "#view-title";

            // An empty feed view usually means sources were just added (one source, or an OPML
            // import landing on All): their first fetch runs in the background, so check back
            // until articles arrive. (Navigating here creates a new instance of this page, so the
            // subscribe and import handlers can't do this themselves.)
            if (_items.Count == 0 && _view.Kind is ViewKind.Source or ViewKind.All or ViewKind.Today or ViewKind.Folder)
            {
                _ = WatchNewSourceAsync(_view);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JS only exists once the circuit is up; there's no prerender for this page (PLAN D42).
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/reader.js");
            _self = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("init", _self);
            await _module.InvokeVoidAsync("watchScroll", _markMode == MarkReadMode.OnScroll);
        }

        if (_module is null)
        {
            return;
        }

        if (_listChanged)
        {
            _listChanged = false;
            await _module.InvokeVoidAsync("observeItems");
        }

        if (_focusAfterRender is { } selector)
        {
            _focusAfterRender = null;
            await _module.InvokeVoidAsync("focus", selector);
        }
    }

    // ---- Loading -----------------------------------------------------------------------

    private async Task ReloadListAsync()
    {
        var page = _view.Kind == ViewKind.Search
            ? await Reading.SearchAsync(_userId, CurrentSearch(), null, _disposed.Token)
            : await Reading.GetArticlesAsync(_userId, _view, _preference.Sort, _preference.UnreadOnly, null, _disposed.Token);
        _items = page.Items.Select(Proxied).ToList();
        _next = page.Next;
        _listChanged = true;
    }

    private async Task ReloadNavAsync() => _nav = await Reading.GetNavAsync(_userId, _disposed.Token);

    private async Task ReloadNavAndRenderAsync()
    {
        await ReloadNavAsync();
        StateHasChanged();
    }

    private async Task LoadMoreAsync()
    {
        if (_next is null || _loadingMore)
        {
            return;
        }

        _loadingMore = true;
        try
        {
            var page = _view.Kind == ViewKind.Search
                ? await Reading.SearchAsync(_userId, CurrentSearch(), _next, _disposed.Token)
                : await Reading.GetArticlesAsync(_userId, _view, _preference.Sort, _preference.UnreadOnly, _next, _disposed.Token);
            _items.AddRange(page.Items.Where(i => _items.All(x => x.ArticleId != i.ArticleId)).Select(Proxied));
            _next = page.Next;
            _listChanged = true;
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private async Task RefreshNavPeriodicallyAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        try
        {
            while (await timer.WaitForNextTickAsync(_disposed.Token))
            {
                await InvokeAsync(async () =>
                {
                    // An empty list picks up articles that arrived since; a non-empty one is left
                    // alone so the reader's place isn't lost.
                    await (_items.Count == 0 && _view.Kind != ViewKind.Search
                        ? Task.WhenAll(ReloadListAsync(), ReloadNavAsync())
                        : ReloadNavAsync());
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
            // Circuit closed.
        }
    }

    // ---- Preferences -------------------------------------------------------------------

    private static string LayoutLabel(ArticleLayout layout) => layout switch
    {
        ArticleLayout.TitleOnly => "Titles",
        ArticleLayout.Magazine => "Magazine",
        _ => "Cards",
    };

    private Task SetLayoutAsync(ArticleLayout layout)
    {
        _preference.Layout = layout;
        return SavePreferenceAsync(reload: false);
    }

    private Task SetSortAsync(ChangeEventArgs e)
    {
        _preference.Sort = Enum.Parse<ArticleSort>((string)e.Value!);
        return SavePreferenceAsync(reload: true);
    }

    private Task SetUnreadOnlyAsync(ChangeEventArgs e)
    {
        _preference.UnreadOnly = (bool)e.Value!;
        return SavePreferenceAsync(reload: true);
    }

    private async Task SavePreferenceAsync(bool reload)
    {
        await Reading.SaveViewPreferenceAsync(_userId, _view, _preference.Layout, _preference.Sort, _preference.UnreadOnly, _disposed.Token);
        if (reload)
        {
            await ReloadListAsync();
        }
    }

    // ---- Articles ----------------------------------------------------------------------

    private async Task OpenAsync(long articleId)
    {
        _article = await Reading.GetArticleAsync(_userId, articleId, _disposed.Token);
        if (_article is null)
        {
            return;
        }

        // Images load through the proxy when it's on (PLAN D54); rewritten here, not at ingest.
        _article = _article with
        {
            ContentHtml = Proxy.RewriteHtml(_article.ContentHtml),
            FullTextHtml = _article.FullTextHtml is { } full ? Proxy.RewriteHtml(full) : null,
        };

        if (_markMode != MarkReadMode.Manual && !_article.IsRead)
        {
            await SetReadAsync(articleId, true);
        }

        _focusAfterRender = "#pane-title";
        _fullTextError = null;

        if (_article.AlwaysFullText && _article.FullTextHtml is null && _article.Url is not null)
        {
            await LoadFullTextAsync();
        }
    }

    private async Task LoadFullTextAsync()
    {
        // A second click arrives while the first is still fetching (PLAN D50).
        if (_fullTextLoading || _article is not { } article)
        {
            return;
        }

        _fullTextLoading = true;
        _fullTextError = null;
        StateHasChanged();
        try
        {
            var result = await FullText.GetAsync(_userId, article.ArticleId, _disposed.Token);
            if (_article?.ArticleId == article.ArticleId)
            {
                _fullTextError = result.Error;
                if (result.Html is not null)
                {
                    _article = _article with { FullTextHtml = Proxy.RewriteHtml(result.Html) };
                }
            }
        }
        finally
        {
            _fullTextLoading = false;
        }
    }

    private Task CloseAsync()
    {
        if (_article is { } closed)
        {
            _focusAfterRender = $"#article-{closed.ArticleId}";
        }

        _article = null;
        return Task.CompletedTask;
    }

    private async Task ToggleReadAsync(long articleId)
    {
        var current = _items.FirstOrDefault(i => i.ArticleId == articleId)?.IsRead ?? _article?.IsRead ?? false;
        await SetReadAsync(articleId, !current);
    }

    private async Task SetReadAsync(long articleId, bool read)
    {
        await Reading.SetReadAsync(_userId, [articleId], read, _disposed.Token);
        Update(articleId, i => i with { IsRead = read });
        if (_article?.ArticleId == articleId)
        {
            _article = _article with { IsRead = read };
        }

        await ReloadNavAsync();
    }

    private async Task ToggleSavedAsync(long articleId)
    {
        var saved = !(_items.FirstOrDefault(i => i.ArticleId == articleId)?.IsSaved ?? _article?.IsSaved ?? false);
        await Reading.SetSavedAsync(_userId, articleId, saved, _disposed.Token);
        Update(articleId, i => i with { IsSaved = saved });
        if (_article?.ArticleId == articleId)
        {
            _article = _article with { IsSaved = saved };
        }

        await ReloadNavAsync();
    }

    private ArticleListItem Proxied(ArticleListItem item) => item with { ThumbnailUrl = Proxy.Url(item.ThumbnailUrl) };

    private void Update(long articleId, Func<ArticleListItem, ArticleListItem> change)
    {
        var index = _items.FindIndex(i => i.ArticleId == articleId);
        if (index >= 0)
        {
            _items[index] = change(_items[index]);
        }
    }

    private async Task MarkAllReadAsync(TimeSpan? olderThan)
    {
        await Reading.MarkAllReadAsync(_userId, _view, olderThan, _disposed.Token);
        await CloseDialogAsync("mark-all-dialog");
        await Task.WhenAll(ReloadListAsync(), ReloadNavAsync());
    }

    // ---- Dialogs -----------------------------------------------------------------------

    private async Task OpenMarkAllAsync() => await ShowDialogAsync("mark-all-dialog");

    private async Task ShowHelpAsync() => await ShowDialogAsync("help-dialog");

    private async Task OpenAddSourceAsync()
    {
        _folders = await Library.ListFoldersAsync(_userId, _disposed.Token);
        _addSource?.Reset();
        await ShowDialogAsync("add-source-dialog");
    }

    private async Task OnSubscribedAsync(long subscriptionId)
    {
        await CloseDialogAsync("add-source-dialog");
        await ReloadNavAsync();
        Navigation.NavigateTo($"source/{subscriptionId}");

    }

    private async Task WatchNewSourceAsync(ReaderView view)
    {
        try
        {
            for (var attempt = 0; attempt < 15; attempt++)
            {
                await Task.Delay(TimeSpan.FromSeconds(2), _disposed.Token);
                var done = false;
                await InvokeAsync(async () =>
                {
                    if (_view != view)
                    {
                        done = true;
                        return;
                    }

                    await Task.WhenAll(ReloadListAsync(), ReloadNavAsync());
                    StateHasChanged();
                    done = _items.Count > 0;
                });
                if (done)
                {
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Circuit closed.
        }
    }

    private async Task ShowDialogAsync(string id)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("showDialog", id);
        }
    }

    private async Task CloseDialogAsync(string id)
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("closeDialog", id);
        }
    }

    // ---- Called from reader.js ---------------------------------------------------------

    [JSInvokable]
    public async Task OnShortcut(string key)
    {
        var index = _article is null ? -1 : _items.FindIndex(i => i.ArticleId == _article.ArticleId);
        switch (key)
        {
            case "j":
                if (index + 1 >= _items.Count)
                {
                    await LoadMoreAsync();
                }

                if (index + 1 < _items.Count)
                {
                    await OpenAsync(_items[index + 1].ArticleId);
                }

                break;
            case "k":
                if (index > 0)
                {
                    await OpenAsync(_items[index - 1].ArticleId);
                }

                break;
            case "o" or "Enter":
                if (_article is null && _items.Count > 0)
                {
                    await OpenAsync(_items[0].ArticleId);
                }

                break;
            case "v":
                if (_article?.Url is { } url && _module is not null)
                {
                    await _module.InvokeVoidAsync("openOriginal", url);
                }

                break;
            case "s":
                if (_article is not null)
                {
                    await ToggleSavedAsync(_article.ArticleId);
                }

                break;
            case "m":
                if (_article is not null)
                {
                    await ToggleReadAsync(_article.ArticleId);
                }

                break;
            case "shift+a":
                if (_view.Kind != ViewKind.Saved)
                {
                    await OpenMarkAllAsync();
                }

                break;
            case "?":
                await ShowHelpAsync();
                break;
            case "Escape":
                await CloseAsync();
                break;
            case "ga":
                Navigation.NavigateTo("");
                break;
            case "gt":
                Navigation.NavigateTo("today");
                break;
            case "gs":
                Navigation.NavigateTo("saved");
                break;
        }

        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnScrolledPast(long[] articleIds)
    {
        var unread = articleIds.Where(id => _items.Any(i => i.ArticleId == id && !i.IsRead)).ToList();
        if (unread.Count == 0)
        {
            return;
        }

        await Reading.SetReadAsync(_userId, unread, true, _disposed.Token);
        foreach (var id in unread)
        {
            Update(id, i => i with { IsRead = true });
        }

        await ReloadNavAsync();
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnNearEnd()
    {
        await LoadMoreAsync();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await _disposed.CancelAsync();
        _disposed.Dispose();
        try
        {
            if (_module is not null)
            {
                await _module.InvokeVoidAsync("dispose");
                await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // The browser is already gone.
        }

        _self?.Dispose();
    }
}
