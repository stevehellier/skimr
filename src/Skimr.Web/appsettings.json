{
  "Database": {
    "Provider": "Sqlite",
    "ConnectionString": "",
    "AutoMigrate": true
  },
  "Storage": {
    "DataDirectory": "data"
  },
  "Server": {
    "BasePath": "",
    "KnownProxies": "",
    "KnownNetworks": "",
    "PublicUrl": ""
  },
  "Fetch": {
    "Enabled": true,
    "Concurrency": 8,
    "DefaultIntervalMinutes": 30,
    "TimeoutSeconds": 30,
    "MaxResponseMegabytes": 10,
    "MaxRedirects": 5,
    "UserAgent": "",
    "AllowPrivateNetworkFeeds": false
  },
  "Content": {
    "AllowedEmbedHosts": "www.youtube.com,www.youtube-nocookie.com,player.vimeo.com"
  },
  "ImageProxy": {
    "Enabled": true
  },
  "Retention": {
    "Enabled": true,
    "Days": 60
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    }
  },
  "AllowedHosts": "*"
}
